---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const guides = [
  {
    slug: 'bcourses',
    icon: '\u{1F4D8}',
    name: 'bCourses access token',
    description: 'Generate a Canvas access token from your bCourses account. This is the one credential OpenMind needs, and it stays in your operating system\u2019s keychain.',
    time: '2 min',
  },
  {
    slug: 'connect',
    icon: '\u{1F5A5}',
    name: 'Connect to Claude or ChatGPT',
    description: 'Point Claude Desktop, Claude Code, Cursor, or the ChatGPT desktop app at OpenMind. One config block per app, no secrets in any of them.',
    time: '3 min',
  },
];
---

<Layout title="Setup Guides — OpenMind" description="Step-by-step guides to connect OpenMind to bCourses and to Claude, Cursor, or ChatGPT.">
  <Nav />
  <main>
    <section class="pt-28 pb-20 md:pt-36 md:pb-28">
      <div class="container">
        <div class="text-center mb-20 fade-in">
          <div class="badge mb-5">Setup Guides</div>
          <h1 class="text-3xl md:text-5xl font-bold text-text-primary tracking-tight mb-5">
            Two steps.<br/><span class="text-cal-gold">That&rsquo;s the whole setup.</span>
          </h1>
          <p class="text-text-body text-lg max-w-2xl mx-auto">
            A bCourses token, and a line of config in the AI app you already use.
            No OpenMind account, no API keys to buy, nothing to deploy.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
          {guides.map((guide, i) => (
            <a href={`/guides/${guide.slug}/`} class="card glow fade-in group" style={`transition-delay: ${0.1 * (i + 1)}s`}>
              <div class="flex items-start justify-between mb-3">
                <div class="text-2xl">{guide.icon}</div>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-semibold text-cal-gold uppercase tracking-widest">Step {i + 1}</span>
                  <span class="text-xs text-text-muted">{guide.time}</span>
                </div>
              </div>
              <h3 class="text-text-primary font-semibold mb-2 group-hover:text-cal-gold transition-colors">{guide.name}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{guide.description}</p>
            </a>
          ))}
        </div>

        <div class="max-w-4xl mx-auto mt-8 fade-in">
          <div class="card border-border/50">
            <h3 class="text-text-primary font-semibold mb-2 text-sm">Then, if you want it</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              Run <code class="text-text-secondary">openmind index --course &lt;id&gt;</code> to make one course&rsquo;s
              slides and readings searchable, so tutoring can quote them with page citations.
              It extracts text into a private file on your machine, and
              <code class="text-text-secondary">openmind clear</code> deletes it. Nothing is stored until you ask.
            </p>
          </div>
        </div>

        <div class="text-center mt-16 fade-in">
          <a href="/#install" class="btn-secondary">
            &larr; Back to Install
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
