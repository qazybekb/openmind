---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const categories = [
  {
    name: "Deadlines",
    icon: "\u23F0",
    about: "OpenMind reads your bCourses planner, converts every due date into your own time zone, works out what each item is worth from your course's assignment-group weights, estimates how long it will take, and computes the last day you can start. Anything past due and unsubmitted is listed first, separately, so it can't get buried.",
    setup: "Works as soon as setup is done.",
    templates: [
      { q: "What's due this week?", desc: "Ranked by urgency, with weights and start-by dates" },
      { q: "What's due for NLP?", desc: "One course at a time" },
      { q: "Am I missing anything?", desc: "Past-due work that was never submitted" },
      { q: "What should I work on right now?", desc: "The top of the ranked list, and why it's there" },
      { q: "Do I have anything due tomorrow?", desc: "Calendar days in your zone, not 24-hour blocks" },
      { q: "Show me everything due in the next two weeks", desc: "A wider window" },
      { q: "Is my Tuesday deadline actually Tuesday?", desc: "An 11:59 PM deadline is not the next day" },
      { q: "What have I already submitted this week?", desc: "Submission status straight from bCourses" },
      { q: "What's due that has no deadline set?", desc: "Undated work, which the planner hides" },
    ]
  },
  {
    name: "Grades",
    icon: "\u{1F4CA}",
    about: "Your own scores, exactly as bCourses reports them, broken down by assignment group. Ungraded work is never counted as a zero, and a course with no posted score says so rather than showing a misleading number. OpenMind reads grades for yourself only \u2014 there is no code path to anyone else's.",
    setup: "Works as soon as setup is done.",
    templates: [
      { q: "What are my grades?", desc: "Every enabled course, with the letter grade bCourses shows" },
      { q: "Break down my grade in STAT 156", desc: "Assignment groups, their weights, and recent graded work" },
      { q: "What's my worst grade right now?", desc: "Where attention is most useful" },
      { q: "How much is problem set 3 worth?", desc: "Computed from group weights, not guessed" },
      { q: "What's still ungraded in NLP?", desc: "Submitted work waiting on a GSI" },
      { q: "Which assignments are worth the most this semester?", desc: "Weight across all your courses" },
    ]
  },
  {
    name: "Assignments",
    icon: "\u270D\uFE0F",
    about: "The full assignment description and rubric from bCourses, plus the facts around it: your due date (so an extension shows up), what it's worth, how long it should take, and when to start. Ask for help and you get the task explained and a plan \u2014 not text written for you to submit.",
    setup: "Works as soon as setup is done. Better once the course is indexed.",
    templates: [
      { q: "Explain problem set 3", desc: "What it asks, what the rubric rewards, and a time plan" },
      { q: "Explain the midterm report using the week 3 slides", desc: "The same, with cited excerpts from your materials" },
      { q: "What does the rubric actually want here?", desc: "Criterion by criterion, with the points attached" },
      { q: "How should I structure this essay?", desc: "An outline, from the rubric" },
      { q: "Did I already submit this?", desc: "Submission state, attempts, and whether it was late" },
      { q: "When do I need to start the final project?", desc: "A start-by date from the hour estimate" },
    ]
  },
  {
    name: "Tutoring",
    icon: "\u{1F9E0}",
    about: "Ask a factual question and you get a direct answer. Ask to learn something and the mode changes: diagnose what you already know, teach one building block, check with a scenario question, and climb a hint ladder rather than handing over the answer. It teaches from your own course materials once the course is indexed, and quotes what your syllabus says about AI so it works inside your instructor's rules.",
    setup: "Run openmind index --course <id> so it can quote your slides and readings.",
    templates: [
      { q: "Tutor me on confounding", desc: "Socratic tutoring from your course's own materials" },
      { q: "I don't understand backpropagation", desc: "Starts by finding where it actually breaks down" },
      { q: "/answer", desc: "Ends the Socratic mode and gives the answer, no lecture" },
      { q: "Quiz me on this week's reading", desc: "One question at a time, confidence before the reveal" },
      { q: "Explain this like I've never seen it before", desc: "A concrete analogy, then a worked example" },
      { q: "Am I allowed to use AI for this course?", desc: "Quotes what your syllabus says, rather than guessing" },
    ]
  },
  {
    name: "Course materials",
    icon: "\u{1F4D6}",
    about: "By default OpenMind can see the names of your files and modules. Index a course and it extracts the text of its PDFs, slide decks, pages, and syllabus into a private file on your machine \u2014 so it can search inside them and quote a specific page. Scanned PDFs and unsupported formats are reported as such, never silently skipped.",
    setup: "openmind index --course <id>. openmind clear deletes it.",
    templates: [
      { q: "Where do the slides cover instrumental variables?", desc: "Page-cited hits from inside your decks" },
      { q: "What did the professor say about the midterm format?", desc: "Searches announcements and the syllabus" },
      { q: "Show me week 3's materials", desc: "Everything in that module, in order" },
      { q: "Read me page 12 of the week 4 reading", desc: "The document as text, with page markers" },
      { q: "What's the late policy?", desc: "Quoted from the syllabus, with the citation" },
      { q: "Index my causal inference course", desc: "Makes that course's materials searchable" },
    ]
  },
  {
    name: "Planning your week",
    icon: "\u{1F5D3}\uFE0F",
    about: "A study plan built from real deadlines rather than a guess: overdue work first, each item scheduled to start no later than its start-by date, in blocks you could actually sit through, with a buffer before anything heavy. OpenMind cannot write to your calendar \u2014 it produces a plan you follow, not a claim that it scheduled something.",
    setup: "Works as soon as setup is done.",
    templates: [
      { q: "Plan my week", desc: "A schedule from your real deadlines and hour estimates" },
      { q: "I only have 6 hours this weekend \u2014 what matters most?", desc: "Triage by weight and urgency" },
      { q: "What should I do first today?", desc: "One thing, with the reason" },
      { q: "I'm behind. Where do I start?", desc: "Overdue work first, still-submittable first" },
      { q: "How many hours of work do I have this week?", desc: "The total across everything open" },
    ]
  },
  {
    name: "Choosing courses",
    icon: "\u{1F393}",
    about: "The whole Berkeley catalog \u2014 11,000 undergraduate and graduate courses across 240 departments \u2014 plus the part that actually decides your semester: which of them have sections this term. Every result carries the date the snapshot was taken, and course advice always ends with the reminder to check requirements with your advisor.",
    setup: "No setup or bCourses token needed.",
    templates: [
      { q: "What should I take next semester if I'm into NLP?", desc: "Matches filtered to what's offered, with reasons" },
      { q: "Is STAT 156 offered this fall?", desc: "Live sections, times, instructors, and seats" },
      { q: "What are the 4-unit graduate courses in the I School?", desc: "Filter by level, units, and department" },
      { q: "Tell me about COMPSCI 189", desc: "Full description, units, repeat rules, cross-listings" },
      { q: "What causal inference courses does Berkeley have?", desc: "Keyword search across the whole catalog" },
      { q: "Who teaches INFO 259 this term?", desc: "Straight from the public class schedule" },
      { q: "Is that course offered in the spring?", desc: "Says plainly when the Registrar hasn't posted it yet" },
    ]
  },
];

const totalTemplates = categories.reduce((sum, cat) => sum + cat.templates.length, 0);
---

<Layout title="Use Cases — OpenMind" description="Ways to use OpenMind: prompts for deadlines, grades, tutoring from your own course materials, and choosing courses.">
  <Nav />
  <main>
    <section class="pt-32 pb-16 md:pt-40 md:pb-20">
      <div class="container text-center">
        <div class="badge mb-8">
          <span>💡</span>
          {totalTemplates} use cases
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-text-primary leading-tight tracking-tight mb-6">
          What can you ask<br/><span class="text-cal-gold">OpenMind?</span>
        </h1>
        <p class="text-lg text-text-secondary max-w-xl mx-auto mb-4">
          Copy any prompt into Claude, Cursor, or ChatGPT once OpenMind is connected.
        </p>
        <p class="text-sm text-text-secondary max-w-md mx-auto">
          Each section explains what OpenMind computes for you, and what setup it needs.
        </p>
      </div>
    </section>

    <!-- Category navigation -->
    <div class="container mb-16">
      <div class="flex flex-wrap justify-center gap-2">
        {categories.map((cat) => (
          <a href={`#${cat.name.toLowerCase().replace(/[^a-z]/g, '-')}`}
             class="badge hover:border-border-hover hover:text-text-secondary transition-colors">
            <span>{cat.icon}</span>
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Category sections -->
    <div class="container pb-20">
      {categories.map((cat) => (
        <section id={cat.name.toLowerCase().replace(/[^a-z]/g, '-')} class="mb-20 fade-in">
          <!-- Category header -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-text-primary mb-3 flex items-center gap-3">
              <span class="text-3xl">{cat.icon}</span>
              {cat.name}
            </h2>
            <p class="text-text-secondary text-sm leading-relaxed max-w-3xl mb-3">
              {cat.about}
            </p>
            <p class="text-text-secondary text-xs">
              <span class="text-text-primary font-medium">Setup:</span> {cat.setup}
            </p>
          </div>

          <!-- Prompts grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {cat.templates.map((t) => (
              <div class="card group cursor-pointer" onclick={`navigator.clipboard.writeText('${t.q.replace(/'/g, "\\'")}'); this.querySelector('.copy-hint').textContent = 'Copied!'; setTimeout(() => this.querySelector('.copy-hint').textContent = 'Click to copy', 1500);`}>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-text-primary text-sm font-medium mb-1">&ldquo;{t.q}&rdquo;</p>
                    <p class="text-text-secondary text-xs">{t.desc}</p>
                  </div>
                  <span class="copy-hint text-[10px] text-text-secondary opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap mt-1">Click to copy</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
