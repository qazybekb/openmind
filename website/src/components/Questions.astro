---
const prompts = [
  { q: "What's due this week?", a: "Ranked by urgency, with weights, hour estimates, and start-by dates. Overdue work listed first." },
  { q: "Is my Tuesday deadline actually Tuesday?", a: "Your time zone, read off your Canvas profile — not UTC, not your laptop's clock." },
  { q: "What's my grade in STAT 156?", a: "What bCourses shows, broken down by assignment group. Ungraded work isn't counted as zeros." },
  { q: "Explain problem set 3 using the week 3 slides", a: "The assignment, what the rubric rewards, and cited excerpts from your own materials." },
  { q: "Tutor me on confounding", a: "Questions before answers, one concept at a time, taught from your course's readings." },
  { q: "Quiz me on this week's reading", a: "One question at a time, confidence rating before the reveal, feedback with a citation." },
  { q: "Plan my week", a: "A schedule built from real deadlines, respecting start-by dates and how much you can actually do in a day." },
  { q: "What should I take next semester if I'm into NLP?", a: "Catalog matches filtered to what's actually offered, with prerequisites flagged and the advisor caveat." },
  { q: "Is STAT 156 offered this fall?", a: "Live sections, times, instructors, and open seats from the public class schedule." },
];
---
<section class="section-sm">
  <div class="container">
    <div class="text-center mb-12 fade-in">
      <div class="badge mb-5">Try asking</div>
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-5">
        What can you ask <span class="text-cal-gold">OpenMind?</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {prompts.map((p, i) => (
        <div class="card fade-in" style={`transition-delay: ${0.08 * (i + 1)}s`}>
          <p class="text-text-primary font-medium text-sm mb-2">"{p.q}"</p>
          <p class="text-text-muted text-xs leading-relaxed">{p.a}</p>
        </div>
      ))}
    </div>

    <p class="text-center mt-8 fade-in">
      <a href="/use-cases/" class="text-text-secondary text-sm underline underline-offset-2 hover:text-text-primary transition-colors">
        See more example prompts &rarr;
      </a>
    </p>
  </div>
</section>
