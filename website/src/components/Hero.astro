---
const install = 'uv tool install git+https://github.com/qazybekb/openmind.git';
---
<section class="pt-28 pb-20 md:pt-36 md:pb-28 relative">
  <!-- Subtle radial glow -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 40% at 50% 15%, rgba(253,181,21,0.06), transparent);"></div>

  <div class="container text-center relative z-10">

    <!-- Logo -->
    <div class="mb-8 flex justify-center">
      <img src="/logo.svg" alt="OpenMind logo" class="w-16 h-16 md:w-24 md:h-24 drop-shadow-[0_0_30px_rgba(253,181,21,0.3)]" />
    </div>

    <!-- Product name -->
    <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-black tracking-tight mb-5">
      <span class="text-text-primary">Open</span><span class="text-cal-gold">Mind</span>
    </h1>

    <!-- Tagline -->
    <p class="text-lg md:text-xl text-text-body max-w-2xl mx-auto mb-6 leading-relaxed">
      Your bCourses, in Claude.<br class="hidden md:block"/>
      A read-only Canvas connector for Berkeley students that runs on your own laptop.
    </p>

    <!-- Badge -->
    <div class="badge mb-10">
      Independent student project. Not affiliated with UC Berkeley.
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-4">
      <a href="/#install" class="btn-primary text-base px-8 py-3 font-semibold">
        Get Started &mdash; 5 minutes &rarr;
      </a>
      <a href="https://github.com/qazybekb/openmind" target="_blank" class="btn-secondary text-base px-7 py-3">
        View on GitHub &rarr;
      </a>
    </div>

    <!-- Install command (secondary) -->
    <div class="flex items-center justify-center gap-2 mb-6 max-w-lg mx-auto px-2">
      <code id="install-cmd" class="text-xs text-text-muted font-mono min-w-0 text-left" data-install={install}>{install}</code>
      <button id="copy-btn" class="shrink-0 w-7 h-7 flex items-center justify-center text-text-muted hover:text-text-primary transition-colors" title="Copy" aria-label="Copy install command">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
      </button>
    </div>

    <!-- Works with -->
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mb-10 text-xs text-text-muted">
      <span>Works with</span>
      <span class="text-text-secondary">Claude Desktop</span>
      <span class="text-text-muted/40">&middot;</span>
      <span class="text-text-secondary">Claude Code</span>
      <span class="text-text-muted/40">&middot;</span>
      <span class="text-text-secondary">Cursor</span>
      <span class="text-text-muted/40">&middot;</span>
      <span class="text-text-secondary">ChatGPT desktop</span>
    </div>

    <!-- Hero conversation -->
    <div class="terminal max-w-3xl mx-auto text-left shadow-2xl shadow-black/40 ring-1 ring-white/[0.03]">
      <div class="terminal-header">
        <div class="terminal-dot bg-[#ff5f57]"></div>
        <div class="terminal-dot bg-[#febc2e]"></div>
        <div class="terminal-dot bg-[#28c840]"></div>
        <span class="ml-3 text-xs text-text-muted font-sans">Claude &middot; openmind connected</span>
      </div>
      <div class="terminal-body text-text-secondary text-[13px] md:text-sm">
        <div class="mb-4">
          <span class="text-text-muted">You &rarr;</span> <span class="text-text-primary">What's due this week?</span>
        </div>
        <div class="mb-4 text-text-secondary">Three items, including one overdue.</div>
        <div class="space-y-3 mb-5">
          <div>
            <div><span class="text-red-400 font-medium">OVERDUE</span> &mdash; <span class="text-text-primary">Causal Inference: Problem Set 4</span></div>
            <div class="text-text-muted">was due Tue Sep 1, 11:59 PM &middot; still submittable &middot; 20% of your grade</div>
          </div>
          <div>
            <div><span class="text-cal-gold font-medium">HIGH</span> &mdash; <span class="text-text-primary">Causal Inference: Problem Set 3</span></div>
            <div class="text-text-muted">due tonight 11:59 PM &middot; 20% of grade &middot; ~6h &middot; you should already be on it</div>
          </div>
          <div>
            <div><span class="text-cal-gold font-medium">HIGH</span> &mdash; <span class="text-text-primary">Causal Inference: Midterm 1</span></div>
            <div class="text-text-muted">due Thu Sep 10 &middot; 30% of grade &middot; ~4h &middot; start by Wednesday</div>
          </div>
        </div>
        <div class="text-text-muted">
          Nothing else in NLP until the Final Project on Sep 13.
        </div>
      </div>
    </div>

    <!-- Stats row -->
    <div class="flex flex-wrap items-center justify-center gap-6 md:gap-8 lg:gap-12 mt-16 text-sm text-text-muted">
      <div class="text-center">
        <div class="text-2xl font-bold text-text-primary">12</div>
        <div class="text-xs">read-only tools</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-text-primary">11K</div>
        <div class="text-xs">Berkeley courses</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-text-primary">240</div>
        <div class="text-xs">departments</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-text-primary">0</div>
        <div class="text-xs">accounts to create</div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('copy-btn')?.addEventListener('click', function() {
    const text = document.getElementById('install-cmd')?.dataset.install ?? '';
    const btn = this;
    function showCopied() {
      btn.title = 'Copied';
      btn.setAttribute('aria-label', 'Install command copied');
      btn.classList.add('text-green-500');
      setTimeout(() => {
        btn.title = 'Copy';
        btn.setAttribute('aria-label', 'Copy install command');
        btn.classList.remove('text-green-500');
      }, 1500);
    }

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(showCopied);
    } else {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showCopied();
    }
  });
</script>
